# Zylo Mobile App Environment Configuration

# API Configuration
API_BASE_URL=http://localhost:3000
PROD_API_BASE_URL=https://api.zylo.app

# WebSocket Configuration
WS_URL=ws://localhost:3000
PROD_WS_URL=wss://api.zylo.app

# Notification Settings
NOTIFICATION_POLL_INTERVAL=30000
ERRAND_ACCEPT_TIMEOUT=86400000

# Supabase Configuration (for chat/realtime features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Key (for location services)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App Configuration
ENABLE_NOTIFICATIONS=true
ENABLE_REALTIME_UPDATES=true
